NODE_ENV=development
PORT=5000
# Replace the placeholders with your Atlas database credentials and cluster host.
LINKUP_DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# The existing database containing the users and posts collections.
LINKUP_NS=linkup
# Generate a random secret using the command in README.md.
JWT_SECRET=

# Cloudflare R2 Integration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
